{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "palette": [
        { "slug": "blue-light", "color": "#bae8e8", "name": "Light Blue" },
        { "slug": "blue-dark", "color": "#272344", "name": "Dark Blue" },
        { "slug": "yellow", "color": "#ffd802", "name": "Yellow" },
        { "slug": "white", "color": "#ffffff", "name": "White" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "name": "Oswald",
          "slug": "primary",
          "fontFamily": "Oswald, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Oswald",
              "fontWeight": "200 700",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/oswald/Oswald-VariableFont_wght.ttf"]
            }
          ]
        },
        {
          "name": "Instrument Serif",
          "slug": "secondary",
          "fontFamily": "'Instrument Serif', serif",
          "fontFace": [
            {
              "fontFamily": "Instrument Serif",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": [
                "file:./assets/fonts/instrument-serif/InstrumentSerif-Regular.ttf"
              ]
            },
            {
              "fontFamily": "Instrument Serif",
              "fontWeight": "400",
              "fontStyle": "italic",
              "src": [
                "file:./assets/fonts/instrument-serif/InstrumentSerif-Italic.ttf"
              ]
            }
          ]
        }
      ]
    }
  }
}
