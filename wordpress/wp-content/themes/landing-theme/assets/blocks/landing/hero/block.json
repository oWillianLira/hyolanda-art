{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "landing/hero",
  "title": "Landing Hero",
  "category": "design",
  "icon": "cover-image",
  "description": "Hero section para a Landing Page.",
  "supports": {
    "color": { "text": true, "background": true },
    "spacing": { "margin": true, "padding": true }
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "Minha Landing Page"
    },
    "description": {
      "type": "string",
      "default": "Uma descrição para minha Landing Page."
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageId": {
      "type": "number",
      "default": 0
    },
    "overlayOpacity": {
      "type": "number",
      "default": 50
    }
  }
}
